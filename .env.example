APP_NAME=Agentic GraphRAG Dataset API
APP_VERSION=1.0.0
ENVIRONMENT=development
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=100
CHUNK_TARGET_MIN_TOKENS=400
CHUNK_TARGET_MAX_TOKENS=800
SMALL_CHUNK_THRESHOLD=50
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_VERSION=v1
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BASE_SECONDS=1.0
TG_HOST=https://your-tigergraph-host
TG_GRAPHNAME=AgenticGraphRAG
TG_SECRET=replace-with-a-secret-manager-value
RAG_HNSW_K=300
RAG_TFIDF_K=300
RAG_RRF_CONSTANT=60
RAG_CONTEXT_K=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gpt-4o-mini
RAG_VECTOR_QUERY_NAME=vector_search_k300
